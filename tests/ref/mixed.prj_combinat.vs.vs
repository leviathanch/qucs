    wire n_890_130;
    wire n_910_130;
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=370, S0_y1=350, S0_x2=390, S0_y2=350 *) VProbe #() Pr3 ( n_370_350, n_390_350 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=400, S0_y1=330 *) GND #() \\*  ( n_400_330 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=880, S0_y1=150, S0_x2=900, S0_y2=150 *) VProbe #() Pr5 ( n_880_150, n_900_150 );
    (* qucs_mirrored=0, qucs_rotated=2, S0_x1=590, S0_y1=250, S0_x2=650, S0_y2=250 *) Vdc #(.U(1 V)) V3 ( n_590_250, n_650_250 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=730, S0_y1=310 *) GND #() \\*  ( n_730_310 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=620, S0_y1=310 *) GND #() \\*5  ( n_620_310 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=910, S0_y1=130 *) GND #() \\*4  ( n_910_130 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=710, S0_y1=80, S0_x2=710, S0_y2=100, S0_x3=710, S0_y3=120, S0_x4=710, S0_y4=150, S0_x5=710, S0_y5=170, S0_x6=710, S0_y6=190, S0_x7=710, S0_y7=210, S0_x8=810, S0_y8=130 *) mux4to1 #(.TR(6),.Delay(1)) Y5 ( n_710_80, n_710_100, n_710_120, n_710_150, n_710_170, n_710_190, n_710_210, n_810_130 );
    (* qucs_mirrored=0, qucs_rotated=2, S0_x1=90, S0_y1=180, S0_x2=150, S0_y2=180 *) Vrect #(.U(1),.TH(20 ns),.TL(20 ns),.Tr(1 ns),.Tf(1 ns),.Td(0)) V1 ( n_90_180, n_150_180 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=120, S0_y1=260 *) GND #() \\*  ( n_120_260 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=320, S0_y1=90, S0_x2=340, S0_y2=90 *) VProbe #() Pr1 ( n_320_90, n_340_90 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=350, S0_y1=70 *) GND #() \\*6  ( n_350_70 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=130, S0_y1=450 *) GND #() \\*  ( n_130_450 );
    (* qucs_mirrored=0, qucs_rotated=2, S0_x1=100, S0_y1=390, S0_x2=160, S0_y2=390 *) Vrect #(.U(1),.TH(10 ns),.TL(10 ns),.Tr(1 ns),.Tf(1 ns),.Td(10ns)) V2 ( n_100_390, n_160_390 );
